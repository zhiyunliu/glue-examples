{
	"app":{
		"BASE_SECRET_ENV_NAME":"DB_SECRET_KEY",
		"mode":"release",
		"trace_addr":":18082",
		"ip_mask":"192.168",
		"dependencies":["After=network.target"],
		"options":{"LimitNOFILE":10240,"MaxOPENFiles":4096}
	},
	"registry":"nacos://default",	

	"dlocker":"redis://localhost",
 	"dbs":{
		"localhost":{"proto":"mysql","conn":"root:123456@tcp(localhost)/demo?charset=utf8","max_open":10,"max_idle":10,"life_time":100},
		"dev":{"debug":true, "show_query_log":true, "proto":"sqlserver",
		"conn":"server=env-test;database={DB_DATABASE};persist security info=false;user id={DB_USER_NAME};password={DB_USER_PWD};Min Pool Size=5;Max Pool Size=20;",
		"max_open":20,"max_idle":20,"life_time":600}
	},
	"rpcs":{
		"default":{"proto":"grpc"}
	},
	"xhttp":{
		"default":{}
	},
	"caches":{
		"default":{"proto":"redis","addr":"redis://localhost"}
	},
	"queues":{				 
		"default":{"proto":"redis","addr":"redis://localhost"},
		"streamredis":{"proto":"streamredis","addr":"redis://localhost"}
	},
	"redis":{
		"localhost":{
			"addrs":["localhost:6379"],
			"db":1,
			"dial_timeout":10,
			"read_timeout":10,
			"write_timeout":10,
			"pool_size":20
		}
	},
	"nacos":{
		"default":{
			"encrypt":false,
			"client":{"namespace_id":""},
			"server":[{"ipaddr":"192.168.3.27","port":8848}],
			"options":{"prefix":"api","group":"charge","cluster":"grey","weight":100}
		}
	},
	"consul":{
		"default":{
			"addr":"localhost:8500",
			"datacenter":"",
			"namespace":"",
			"partition":"",
			"scheme":"",
			"token":""
		}
	},
    "servers":{
		"apiserver":{
			"config":{"addr":":8084","status":"start" ,
			"read_timeout":120,
			"write_timeout":120,
			"read_header_timeout":120
		},
			"middlewares":[{"name":"metrics","data":{"proto":"prometheus"}}
		],			
			"header":{"a":"1","b":"2"}
		}
    },
	"opentelemetry":{
		"insecure":true,
		"trace_endpoint":"http://192.168.1.155:4318",
		"trace_sample_rate":100
	}
}