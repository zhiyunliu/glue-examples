{
	"app": {
		"BASE_SECRET_ENV_NAME": "DB_SECRET_KEY",
		"mode": "release",
		"ip_mask": "192.168"
	},
	"dbs": {
		"xdb-mysql": {
			"proto": "mysql",
			"conn": "{DB_USER_NAME}:{DB_USER_PWD}@tcp(localhost)/demo?charset=utf8",
			"max_open": 10,
			"max_idle": 10,
			"life_time": 100
		},
		"xdb-mssql": {
			"proto": "mssql",
			"conn":"server=env-test;database={DB_DATABASE};persist security info=false;user id={DB_USER_NAME};password={DB_USER_PWD};Min Pool Size=5;Max Pool Size=20;",
			"max_open": 20,
			"max_idle": 20,
			"life_time": 600
		}
	},
	"servers": {
		"apiserver": {
			"config": {
				"addr": ":8083",
				"status": "start",
				"read_timeout": 120,
				"write_timeout": 120,
				"read_header_timeout": 120
			},
			"middlewares": [
				{
					"name": "metrics",
					"data": {
						"proto": "prometheus"
					}
				}
			],
			"header": {
				"a": "1",
				"b": "2"
			}
		}
	},
	"opentelemetry":{
		"insecure":true,
		"trace_endpoint":"http://192.168.1.155:4318",
		"trace_sample_rate":100
	}
}